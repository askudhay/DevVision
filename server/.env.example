PORT=3000

# GitHub account/org whose repos are listed, and the name filter
# (same as https://github.com/<owner>?tab=repositories&q=<filter>)
GITHUB_OWNER=jonathan-nobrega
GITHUB_REPO_FILTER=crewclaro
# Optional for public repos, but raises the GitHub rate limit from 60 to 5000 req/hour.
# Required if the repos are private.
GITHUB_TOKEN=

# Google AI key. Gemma models are served through the Gemini Developer API.
GOOGLE_API_KEY=
# true = Vertex AI on Google Cloud (needs the Agent Platform / Vertex AI API enabled on the
# key's project). false = Gemini Developer API (generativelanguage.googleapis.com).
GOOGLE_GENAI_USE_VERTEXAI=false
# Any model the key can call, e.g. gemma-4-31b-it, gemini-3.8-flash, gemini-3.5-flash-lite
LLM_MODEL=gemma-4-31b-it
